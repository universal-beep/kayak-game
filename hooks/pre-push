#!/bin/sh
# Перед каждой отправкой на GitHub — сторож просьб (tools/guard.mjs):
# все тесты; упавший перезапускается (случайное падение — предупреждение);
# сторож сделанной просьбы упал или пропал — отправка стоит, с номером просьбы.
# Установка: cp hooks/pre-push .git/hooks/pre-push
echo "[quality-gates] сторож просьб..."
node tools/guard.mjs || exit 1
exit 0
